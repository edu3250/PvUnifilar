{
  "mcpServers": {
    "pvsld": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "pvsld==0.7.2",
        "pvsld-mcp"
      ],
      "env": {
        "PYTHONUTF8": "1",
        "PVSLD_OUTPUT_DIR": "${user_config.output_dir}",
        "PVSLD_MCP_PROMPTS": "off"
      }
    }
  }
}
